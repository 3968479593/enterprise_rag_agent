# 复制本文件为 .env 后填写（.env 含真实密钥不入库；本文件是公开模板）
# LLM 与 Embedding 均可独立配置，全部走 OpenAI 兼容接口。
# 注意：DeepSeek 官方没有 /embeddings 接口，若 LLM 用 DeepSeek，
#       EMBEDDING_API_BASE / EMBEDDING_API_KEY / EMBEDDING_MODEL 三者必须补上（智谱/硅基流动/本地任选）。

# ============ 应用 ============
APP_NAME=企业文档智能客服
DEBUG=false

# ============ LLM（DeepSeek / 豆包 / OpenAI / Ollama 均可） ============
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60

# ============ Embedding（独立配置；留空则回退 LLM 地址/密钥 —— 但 DeepSeek 无 embedding 接口，务必二选一） ============
# 智谱 embedding-3：
#   EMBEDDING_API_BASE=https://open.bigmodel.cn/api/paas/v4
#   EMBEDDING_API_KEY=你的智谱 API Key
#   EMBEDDING_MODEL=embedding-3
# 硅基流动 bge-m3：
#   EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
#   EMBEDDING_API_KEY=你的硅基流动密钥
#   EMBEDDING_MODEL=BAAI/bge-m3
# 本地 Ollama（OpenAI 兼容端点）：
#   EMBEDDING_API_BASE=http://localhost:11434/v1
#   EMBEDDING_API_KEY=ollama
#   EMBEDDING_MODEL=bge-m3
EMBEDDING_API_BASE=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embedding-3

# ============ 检索 ============
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5
# 重排（可选）：RERANK_MODEL 填专用重排模型（如 BAAI/bge-reranker-v2-m3，复用硅基流动 key）则走 /rerank 接口；留空则回退 LLM 重排
RERANK_ENABLED=false
RERANK_MODEL=
TOP_K_DEFAULT=5
# 融合分门槛（0-1），低于此值的低相关片段不进入上下文
SCORE_THRESHOLD=0.15
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# 向量分数权重（1-alpha 为关键词权重）
HYBRID_ALPHA=0.7
# RRF 融合常数
RRF_K=60

# ============ 数据库与向量库（相对路径锚定到 backend 运行目录） ============
DATABASE_URL=sqlite:///./rag.db
CHROMA_PERSIST_DIR=./data/chroma_db
COLLECTION_NAME=enterprise_rag

# ============ 上传存储 ============
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=20

# ============ 联网搜索工具（可选） ============
TAVILY_API_KEY=
TAVILY_SEARCH_URL=https://api.tavily.com/search

# ============ 认证与安全 ============
# 登录 token 有效期（小时），168 = 7 天
TOKEN_TTL_HOURS=168
# 可信前端来源，JSON 数组格式；不允许 * 与 credentials 同用
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# 留空 = 开发模式放行；填了则接口需带 X-API-Key 请求头
ADMIN_API_KEY=
