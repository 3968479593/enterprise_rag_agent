# 复制本文件为 .env 后填写（.env 含真实密钥不入库；本文件是公开模板）
# LLM 与 Embedding 均可独立配置，全部走 OpenAI 兼容接口

# ============ LLM（DeepSeek / 豆包 / OpenAI / Ollama 均可） ============
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60

# ============ Embedding（可独立配置；留空则回退用 LLM 的地址/密钥） ============
# 例：LLM 用 DeepSeek（官方无 embedding），向量化用硅基流动 bge-m3：
#   EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
#   EMBEDDING_API_KEY=你的硅基流动密钥
#   EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# ============ 检索 ============
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5
# 重排（可选）：RERANK_MODEL 填专用重排模型（如 BAAI/bge-reranker-v2-m3，复用硅基流动 key）则走 /rerank 接口；留空则回退 LLM 重排
RERANK_ENABLED=false
RERANK_MODEL=
TOP_K_DEFAULT=5
SCORE_THRESHOLD=0.0
CHUNK_SIZE=800
CHUNK_OVERLAP=120
HYBRID_ALPHA=0.7
RRF_K=60

# ============ 数据库与向量库（相对 backend 运行目录） ============
DATABASE_URL=sqlite:///./rag.db
CHROMA_PERSIST_DIR=./data/chroma_db
COLLECTION_NAME=enterprise_rag

# ============ 上传存储 ============
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=20

# ============ 联网搜索工具（可选） ============
TAVILY_API_KEY=
TAVILY_SEARCH_URL=https://api.tavily.com/search

# ============ 认证（留空 = 开发模式放行；填了则接口需带 X-API-Key 请求头） ============
ADMIN_API_KEY=
